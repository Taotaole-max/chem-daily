{% extends "base.html.j2" %}
{% block title %}{{ site.name }} · {{ issue.date_cn }}{% endblock %}
{% block description %}{{ issue.lead or site.tagline }}{% endblock %}
{% block main %}
<section class="masthead">
  <div class="mh-meta">
    <span>第 {{ issue.number }} 期</span><span>{{ issue.date_cn }} {{ issue.weekday }}</span>
  </div>
  <h1 class="lead">{{ issue.lead }}</h1>
  <div class="mh-nav">
    {% if prev %}<a href="{{ root }}issues/{{ prev }}.html">← 上一期</a>{% endif %}
    {% if next %}<a href="{{ root }}issues/{{ next }}.html">下一期 →</a>{% endif %}
  </div>
</section>

<section class="grid">
{% for it in issue["items"] %}
  <article class="card{% if loop.first %} hero{% endif %}" style="--fc: var(--f{{ field_index[it.field] }})">
    <a class="pic{% if not it.image %} noimg{% endif %}" href="{{ it.link }}" target="_blank" rel="noopener">
      {% if it.image %}<img src="{{ it.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentNode.classList.add('noimg');this.remove()">{% endif %}
      <span class="pic-fallback"><b>{{ it.field }}</b><i>{{ it.source }}</i></span>
    </a>
    <div class="body">
      <div class="meta">
        <span class="chip">{{ it.field }}</span>
        <span class="src">{{ it.source }}{% if it.kind == 'news' %} · 新闻{% elif it.kind == 'preprint' %} · 预印本{% endif %}</span>
      </div>
      <h2><a href="{{ it.link }}" target="_blank" rel="noopener">{{ it.title_zh }}</a></h2>
      <p class="blurb">{{ it.blurb }}</p>
      <p class="en">{{ it.title_en }}</p>
      <div class="foot-row">
        <span class="tags">{% for t in it.tags %}<span>#{{ t }}</span>{% endfor %}</span>
        <a class="read" href="{{ it.link }}" target="_blank" rel="noopener">原文 ↗</a>
      </div>
    </div>
  </article>
{% endfor %}
</section>

{% if issue.fun_fact %}
<section class="funfact">
  <div class="ff-label">冷知识</div>
  <h3>{{ issue.fun_fact.title }}</h3>
  <p>{{ issue.fun_fact.text }}</p>
</section>
{% endif %}

<p class="stats">今天从 {{ n_sources }} 个来源扫了 {{ issue.stats.fetched }} 条新论文和新闻，挑出这 {{ issue["items"]|length }} 条。</p>
{% endblock %}
