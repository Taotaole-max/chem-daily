<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.name }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.tagline }}{% endblock %}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚗️</text></svg>">
<link rel="stylesheet" href="{{ root }}style.css?v={{ css_version }}">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ root }}index.html"><span class="brand-mark">⚗</span>{{ site.name }}<small>{{ site.name_en }}</small></a>
    <nav>
      <a href="{{ root }}index.html" {% if page == 'today' %}class="on"{% endif %}>今日</a>
      <a href="{{ root }}archive.html" {% if page == 'archive' %}class="on"{% endif %}>往期</a>
      <a href="{{ root }}fields.html" {% if page == 'fields' %}class="on"{% endif %}>方向</a>
      <a href="{{ root }}hot.html" {% if page == 'hot' %}class="on"{% endif %}>热榜</a>
      <a href="{{ root }}trends.html" {% if page == 'trends' %}class="on"{% endif %}>趋势</a>
      <a href="{{ root }}search.html" {% if page == 'search' %}class="on"{% endif %}>搜索</a>
      <a href="{{ root }}about.html" {% if page == 'about' %}class="on"{% endif %}>关于</a>
    </nav>
  </div>
</header>
<main class="wrap">
{% block main %}{% endblock %}
</main>
<footer class="wrap foot">
  <p>{{ site.name }} · 内容由 AI 根据论文摘要和新闻自动整理，难免有错，以原文为准。图片版权归原期刊/媒体所有。</p>
</footer>
{% if site.cf_analytics_token %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cf_analytics_token }}"}'></script>
{% endif %}
</body>
</html>
